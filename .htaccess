DirectoryIndex index.html
Options -Indexes

ErrorDocument 404 /404.html

# HTML — always revalidate (no stale cache)
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# CSS / JS — cache 1 week
<FilesMatch "\.(css|js)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>

# Images / fonts / SVG — cache 1 year
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Secrets and dev files are never served, even if PHP stops executing
<FilesMatch "^(contact-config.*\.php|package(-lock)?\.json|\.cpanel\.yml|.*\.(md|mjs|log|bak))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Compression (skipped automatically if the module is missing)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

# Old PT contact URL (live before the rebuild) -> new slug
<IfModule mod_alias.c>
  Redirect 301 /pt-br/contact/ /pt-br/contato/
</IfModule>
